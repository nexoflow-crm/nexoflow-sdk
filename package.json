{
  "name": "nexoflow-sdk",
  "version": "0.2.0",
  "description": "Official SDK for the NexoFlow Content API — fetch AI-generated blog posts and content with full TypeScript support. Zero dependencies, built-in retries, works in any server runtime.",
  "author": "NexoFlow <info@nexoflow.net> (https://nexoflow.net)",
  "homepage": "https://nexoflow.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexoflow-crm/nexoflow-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/nexoflow-crm/nexoflow-sdk/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nexoflow",
    "content-api",
    "blog",
    "ai-content",
    "content-automation",
    "seo",
    "typescript",
    "sdk",
    "blog-api",
    "publishing"
  ],
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false
}
